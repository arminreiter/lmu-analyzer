{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LMU Analyzer",
  "version": "../package.json",
  "identifier": "at.a31.lmu-analyzer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "LMU Analyzer",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "a31.at",
    "copyright": "(c) 2026 a31.at",
    "homepage": "https://lmu.a31.at",
    "shortDescription": "Le Mans Ultimate race data analyzer",
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJBRUZDQzI1RjdGRUE3QjMKUldTenAvNzNKY3p2S2w0RW80TGFFdHpTWkxvcGU1MzMxUFRESW9GUEI0L3g2UjF1OXR4anZMZGQK",
      "endpoints": [
        "https://github.com/arminreiter/lmu-analyzer/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
